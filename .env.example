# ---------- Слюша: бот-собеседник ----------
# Свой токен: это отдельный бот, два поллера на одном токене отбирают
# апдейты друг у друга.
SLUSHA_BOT_TOKEN=
# Кто владелец: видит список доступа и все чаты. Через запятую.
SLUSHA_ADMIN_IDS=

# Мозги. Вариант 1: Anthropic напрямую.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# Вариант 2: OpenRouter (Kimi, DeepSeek и прочие одним ключом)
# AI_PROVIDER=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_MODEL=moonshotai/kimi-k3-20260715

# Вариант 3: локальная модель. Суточный лимит ответов на неё не действует.
# На 4B бот путается в диалоге даже с идеальным промптом: разумный минимум
# для живого чата — 12–14B.
# AI_PROVIDER=ollama
# AI_BASE_URL=http://host.docker.internal:11434
# AI_MODEL=gemma3:12b

# Тонкая настройка (значения по умолчанию годятся).
# AI_NUM_CTX=16384
# AI_REPEAT_PENALTY=1.2
# AI_PERSONA_LIMIT=8000
# LORE_BUDGET=1500
# Температура. Выше 0.7 на маленьких моделях даёт бессвязность.
# AI_TEMPERATURE=0.6
# Потолок токенов на ответ. По умолчанию считается от выбранной длины ответа;
# задайте число, чтобы зафиксировать его вручную для всех режимов.
# AI_MAX_TOKENS=
# Запас токенов там, где размышления не выключаются (Claude): без него модель
# успевает подумать и упереться в потолок, так и не начав отвечать.
# AI_THINKING_RESERVE=3000

# Долговременная память: каждые сколько сообщений пересобирать заметки о чате
# и сколько знаков заметок держать. 0 — не вести заметки вовсе.
# AI_SUMMARY_EVERY=80
# AI_SUMMARY_LIMIT=2500

# Картинки: потолок на файл. Фото уезжает в модель в base64, то есть примерно
# в полтора раза тяжелее самого файла.
# AI_IMAGE_MAX_BYTES=4194304

# ---------- веб-панель ----------
# По умолчанию выключена. Наружу порт выводит туннель (ngrok, cloudflared):
# мини-приложение Telegram открывается только по https.
# SLUSHA_WEB=1
# SLUSHA_WEB_PORT=8082
# Публичный адрес панели. Без него кнопки в меню не будет.
# SLUSHA_WEBAPP_URL=https://slusha.example.com
